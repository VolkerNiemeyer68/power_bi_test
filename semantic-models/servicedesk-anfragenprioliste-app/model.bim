            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "contact",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    SourceTable = (let\n    Quelle = CommonDataService.Database(\"brandgroup-service.crm4.dynamics.com\"),\n    dbo_contact = Quelle{[Schema=\"dbo\",Item=\"contact\"]}[Data]\nin\n    dbo_contact),",
                "    SelectedColumns = Table.SelectColumns(SourceTable, {\"contactid\", \"department\"})",
                "in",
                "    SelectedColumns"
              ]
            }
          }
        ]
