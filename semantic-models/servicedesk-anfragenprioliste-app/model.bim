          {
            "name": "Erstellt am",
            "dataType": "dateTime",
            "sourceColumn": "createdon",
            "summarizeBy": "none",
            "formatString": "Short Date"
          },
          {
            "name": "Erinnerung am",
            "dataType": "dateTime",
            "sourceColumn": "new_bg_reminder_on",
            "summarizeBy": "none",
            "formatString": "Short Date"
          },
          {
            "name": "Fertigstellungsgrad Info",
            "dataType": "string",
            "sourceColumn": "new_fertigstellungsgradinfo",
            "summarizeBy": "none"
          },
          {
            "name": "Anfragetyp",
            "dataType": "string",
            "sourceColumn": "casetypecodename",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Link",
            "expression": "\"https://brandgroup-service.crm4.dynamics.com/main.aspx?appid=8e97e941-f16d-ea11-a811-000d3a2c338a&pagetype=entityrecord&etn=incident&id=\" & CALCULATE(SELECTEDVALUE (incident[Anfrage]))"
          },
          {
            "name": "Sortierung",
            "expression": [
              "",
              "IF(ISBLANK(SELECTEDVALUE(Incident[Erinnerung am])) = TRUE(), 1, IF(DATEDIFF(TODAY(),SELECTEDVALUE(Incident[Erinnerung am]),DAY) < 1, 0, 2)) & ",
              "IF(NOT(ISERROR(SELECTEDVALUE(incident[Fertigstellungsgrad Info]) + 0 )), IF(SELECTEDVALUE(incident[Fertigstellungsgrad Info]) = \"\", 99, INT(VALUE(SELECTEDVALUE(Incident[Fertigstellungsgrad Info])))), 99) & ",
              "IF(SELECTEDVALUE(incident[statuscodename]) = \"Zurückgestellt\", 2, IF(SELECTEDVALUE(incident[statuscodename]) = \"Warten auf Details\", 1, 0))  & ",
              "IF(SELECTEDVALUE(Incident[Anfragetyp]) = \"Fehler\", 0, IF(SELECTEDVALUE(Incident[Anfragetyp]) = \"Problem\", 1, 2)) &",
              "YEAR(SELECTEDVALUE(incident[Erstellt am])) &",
              "MONTH(SELECTEDVALUE(incident[Erstellt am])) &",
              "DAY(SELECTEDVALUE(incident[Erstellt am]))"
            ]
          }
        ],
        "partitions": [
          {
            "name": "incident",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    SourceTable = (let\n    Quelle = CommonDataService.Database(\"brandgroup-service.crm4.dynamics.com\"),\n    dbo_incident = Quelle{[Schema=\"dbo\",Item=\"incident\"]}[Data]\nin\n    dbo_incident),",
                "    SelectedColumns = Table.SelectColumns(SourceTable, {\"incidentid\", \"ticketnumber\", \"title\", \"ownerid\", \"owneridname\", \"owninguser\", \"customerid\", \"customeridname\", \"statecode\", \"statecodename\", \"statuscodename\", \"prioritycodename\", \"createdon\", \"new_bg_reminder_on\", \"new_fertigstellungsgradinfo\", \"casetypecodename\"})",
                "in",
                "    SelectedColumns"
              ]
            }
          }
        ]
      },
